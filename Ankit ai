<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Ankit AI - Chat + Voice + Image</title>
<style>
:root{--primary:#6366f1;--bg:#0f172a;--chat-bg:#1e293b;--text:#f8fafc;--sec:#94a3b8;--user:#6366f1;--ai:#334155}
*{box-sizing:border-box}body{font-family:'Segoe UI',sans-serif;background:var(--bg);color:var(--text);margin:0;display:flex;flex-direction:column;height:100vh;height:100dvh}
header{background:linear-gradient(135deg,#6366f1,#a855f7,#ec4899);padding:12px 16px;display:flex;justify-content:space-between;align-items:center;flex-shrink:0}
header b{font-size:20px}header span{font-size:12px;background:#0003;padding:6px 10px;border-radius:999px}
#chat{flex:1;padding:15px;overflow-y:auto;display:flex;flex-direction:column;gap:12px}
.msg{max-width:88%;padding:12px 16px;border-radius:14px;word-wrap:break-word;line-height:1.5;font-size:15px;white-space:pre-wrap}
.msg.user{background:var(--user);color:#fff;align-self:flex-end;border-bottom-right-radius:2px}
.msg.ai{background:var(--ai);align-self:flex-start;border-bottom-left-radius:2px;border:1px solid rgba(255,255,255,.1)}
.msg img{max-width:100%;border-radius:12px;margin-top:8px;display:block}
.welcome{text-align:center;color:var(--sec);margin:auto;padding:20px}.welcome h2{color:var(--text)}
.input-area{display:flex;padding:10px;background:var(--chat-bg);border-top:1px solid rgba(255,255,255,.1);gap:6px;align-items:center;flex-shrink:0}
input[type=text]{flex:1;padding:12px;background:#0f172a;border:1px solid rgba(255,255,255,.2);color:#fff;border-radius:10px;outline:none;font-size:15px}
.iconBtn{width:44px;height:44px;border-radius:50%;border:0;cursor:pointer;font-size:20px;display:flex;align-items:center;justify-content:center;flex-shrink:0;background:#1e293b;color:#fff;border:1px solid #ffffff33}
.micBtn.listening{background:#ef4444;animation:blink 1s infinite}
@keyframes blink{50%{opacity:.6}}
.sendBtn{background:linear-gradient(135deg,#6366f1,#a855f7);color:#fff;border:0;padding:12px 16px;border-radius:10px;font-weight:600;cursor:pointer}
.topControls{display:flex;gap:6px;padding:8px 12px;background:#0f172a;flex-wrap:wrap;align-items:center}
.topControls button{padding:7px 12px;border-radius:999px;border:1px solid #ffffff33;background:transparent;color:#fff;cursor:pointer;font-size:12px}
.topControls button.active{background:#6366f1}
.modeBtn.active{background:#ec4899 !important;border-color:#ec4899}
#previewBox{display:none;padding:8px 12px;background:#1e293b;border-top:1px solid #ffffff22;align-items:center;gap:10px}
#previewBox img{width:56px;height:56px;object-fit:cover;border-radius:10px}
.speakBtn,.dlBtn{font-size:12px;background:#ffffff22;border:0;color:#fff;padding:5px 10px;border-radius:999px;cursor:pointer;margin:6px 4px 0 0}
.genCard{background:#1e293b;border:1px solid #ec489955;border-radius:14px;padding:10px;margin-top:8px}
.genCard img{width:100%;border-radius:12px}
.promptChips{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px}
.promptChips button{background:#ffffff14;border:1px solid #ffffff22;color:#fff;padding:6px 10px;border-radius:999px;font-size:12px;cursor:pointer}
</style>
</head>
<body>
<header><b>Ankit AI ✨</b><span>Chat • Voice • Image</span></header>

<div class="topControls">
<button id="voiceBtn" class="active" onclick="toggleVoice()">🔊 Voice ON</button>
<button id="modeChat" class="active" onclick="setMode('chat')">💬 Chat</button>
<button id="modeImg" onclick="setMode('image')">🎨 Image Banao</button>
<button onclick="clearChat()">🗑️ Clear</button>
<select id="langSelect" style="background:#1e293b;color:#fff;border-radius:999px;padding:6px 10px;border:1px solid #ffffff33"><option value="hi-IN">Hindi</option><option value="en-IN">English</option><option value="bho">Bhojpuri</option></select>
</div>

<div id="chat">
<div class="welcome" id="welcome">
<h2>नमस्ते! मैं Ankit AI हूँ ✨</h2>
<p>लिखो, बोलो, फोटो भेजो या फोटो बनवाओ!</p>
<div class="promptChips" style="justify-content:center">
<button onclick="quickAsk('Hi, kaise ho?')">👋 Hi</button>
<button onclick="quickAsk('Ek sher ki image banao')">🦁 Sher ki Image</button>
<button onclick="quickAsk('Cricket khelte hue ladke ki image banao')">🏏 Cricket Image</button>
<button onclick="quickAsk('Taj Mahal ki sundar image banao')">🕌 Taj Mahal</button>
</div>
<p style="font-size:13px;margin-top:12px">🎤 Mic = Bolke puchho<br>📷 Camera = Photo bhejo<br>🎨 Image Mode = Photo banwao</p>
</div>
</div>

<div id="previewBox"><img id="imgPreview"><span id="imgName" style="flex:1;font-size:13px">photo.jpg</span><button onclick="removeImage()" style="background:#ef4444;color:#fff;border:0;padding:6px 10px;border-radius:8px">✕</button></div>

<div class="input-area">
<button class="iconBtn" onclick="document.getElementById('fileInput').click()">📷</button>
<input type="file" id="fileInput" accept="image/*" hidden onchange="onImageSelect(event)">
<button class="iconBtn micBtn" id="micBtn" onclick="startListening()">🎤</button>
<input type="text" id="message" placeholder="Likho... ya 'image banao' likho..." onkeydown="if(event.key==='Enter') sendMessage()">
<button class="sendBtn" onclick="sendMessage()">भेजें</button>
</div>

<script>
const chat=document.getElementById("chat");
let voiceOn=true, selectedImage=null, selectedImageBase64=null, mode='chat', isListening=false, recognition=null;

function setMode(m){ mode=m; document.getElementById('modeChat').classList.toggle('active',m==='chat'); document.getElementById('modeImg').classList.toggle('active',m==='image'); document.getElementById('modeImg').classList.toggle('modeBtn',m==='image'); document.getElementById('message').placeholder= m==='image' ? "Image kaisi banani hai? likho... jaise: ek sher..." : "Likho, bolo ya photo bhejo..."; if(m==='image') document.getElementById('message').focus(); }
function toggleVoice(){ voiceOn=!voiceOn; document.getElementById('voiceBtn').innerText=voiceOn?'🔊 Voice ON':'🔇 Voice OFF'; document.getElementById('voiceBtn').classList.toggle('active',voiceOn); if(!voiceOn) speechSynthesis.cancel(); }
function clearChat(){ chat.innerHTML='<div class="welcome" id="welcome"><h2>नमस्ते! मैं Ankit AI हूँ ✨</h2><p>Nayi chat shuru!</p></div>'; }
function quickAsk(t){ document.getElementById('message').value=t; if(t.toLowerCase().includes('image')) setMode('image'); sendMessage(); }

function addMessage(text,type,imgSrc=null){
 const w=document.getElementById("welcome"); if(w) w.remove();
 const div=document.createElement("div"); div.className="msg "+type;
 if(imgSrc){ const im=document.createElement("img"); im.src=imgSrc; div.appendChild(im); }
 const t=document.createElement("div"); t.textContent=text; div.appendChild(t);
 if(type==='ai'){ const sb=document.createElement("button"); sb.className="speakBtn"; sb.innerText="🔊 Suno"; sb.onclick=()=>speak(text); div.appendChild(sb); }
 chat.appendChild(div); chat.scrollTop=chat.scrollHeight; return div;
}

// IMAGE UPLOAD - Photo Samajhne ke liye
function onImageSelect(e){ const file=e.target.files[0]; if(!file) return; const r=new FileReader(); r.onload=(ev)=>{ selectedImageBase64=ev.target.result; selectedImage=ev.target.result; document.getElementById("imgPreview").src=selectedImage; document.getElementById("imgName").innerText=file.name+" - Ab puchho 'ye kya hai?'"; document.getElementById("previewBox").style.display="flex"; document.getElementById("message").placeholder="Photo ke baare me puchho..."; }; r.readAsDataURL(file); }
function removeImage(){ selectedImage=null; selectedImageBase64=null; document.getElementById("previewBox").style.display="none"; document.getElementById("fileInput").value=""; }

// VOICE INPUT
function startListening(){
 if(!('webkitSpeechRecognition' in window || 'SpeechRecognition' in window)){ alert("Chrome me kholo, voice ke liye"); return; }
 if(isListening){ recognition.stop(); return; }
 const SR=window.SpeechRecognition||window.webkitSpeechRecognition; recognition=new SR();
 recognition.lang=document.getElementById("langSelect").value;
 recognition.onstart=()=>{ isListening=true; document.getElementById("micBtn").classList.add("listening"); document.getElementById("micBtn").innerText="🔴"; };
 recognition.onresult=(e)=>{ document.getElementById("message").value=e.results[0][0].transcript; sendMessage(); };
 recognition.onend=()=>{ isListening=false; document.getElementById("micBtn").classList.remove("listening"); document.getElementById("micBtn").innerText="🎤"; };
 recognition.onerror=()=>{ isListening=false; document.getElementById("micBtn").classList.remove("listening"); document.getElementById("micBtn").innerText="🎤"; };
 recognition.start();
}

// VOICE OUTPUT
function speak(text){ if(!voiceOn) return; try{ speechSynthesis.cancel(); const u=new SpeechSynthesisUtterance(text.replace(/[*#]/g,'').slice(0,400)); u.lang=document.getElementById("langSelect").value==='bho'?'hi-IN':document.getElementById("langSelect").value; speechSynthesis.speak(u); }catch(e){} }

// IMAGE GENERATION - Asli Kaam Yaha Hai
function generateImage(prompt){
 // Pollinations Image API - Free, No Key
 const cleanPrompt = encodeURIComponent(prompt + ", high quality, detailed, 4k");
 const seed = Math.floor(Math.random()*99999);
 const url = `https://image.pollinations.ai/prompt/${cleanPrompt}?width=1024&height=1024&seed=${seed}&model=flux&nologo=true`;
 return url;
}

async function callAI(text){
 let messages=[{role:"system",content:"Tum Ankit AI ho. Hindi/Hinglish me short friendly jawab do."}];
 if(selectedImageBase64){ messages.push({role:"user",content:[{type:"text",text:text},{type:"image_url",image_url:{url:selectedImageBase64}}]}); }
 else messages.push({role:"user",content:text});
 const res=await fetch("https://text.pollinations.ai/openai",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({model:"openai",messages,max_tokens:800})});
 if(!res.ok) throw new Error("fail");
 const data=await res.json(); return data.choices?.[0]?.message?.content?.trim();
}

function isImageRequest(text){
 const l=text.toLowerCase();
 return mode==='image' || l.includes("image banao") || l.includes("photo banao") || l.includes("tasveer banao") || l.includes("picture banao") || l.includes("image bana") || l.includes("draw") || l.includes("bana do") && (l.includes("photo")||l.includes("image"));
}

async function sendMessage(){
 const input=document.getElementById("message");
 let text=input.value.trim();
 const imgToSend=selectedImage;
 if(!text && imgToSend) text="Is photo me kya hai? Hindi me batao.";
 if(!text && !imgToSend) return;
 input.value="";
 addMessage(text, "user", imgToSend);
 if(imgToSend) removeImage();

 // 1. IMAGE BANANA HAI?
 if(isImageRequest(text) && !imgToSend){
   let prompt = text.replace(/image banao|photo banao|tasveer banao|picture banao|image bana|bana do|banao/gi,"").trim();
   if(!prompt) prompt=text;
   const loading=addMessage(`🎨 Image bana raha hu... "${prompt}"\nThoda wait karo...`, "ai");
   const imgUrl=generateImage(prompt);
   // Preload
   const testImg=new Image();
   testImg.onload=()=>{
     loading.innerHTML="";
     const title=document.createElement("div"); title.textContent=`🎨 Ho gayi! Tumhari Image: "${prompt}"`; loading.appendChild(title);
     const im=document.createElement("img"); im.src=imgUrl; loading.appendChild(im);
     const dl=document.createElement("a"); dl.href=imgUrl; dl.download="ankit-ai-image.jpg"; dl.target="_blank"; dl.innerHTML='<button class="dlBtn">⬇️ Download Image</button>'; loading.appendChild(dl);
     const again=document.createElement("button"); again.className="dlBtn"; again.innerText="🔄 Dobara Banao"; again.onclick=()=>{ document.getElementById("message").value="Isi ki ek aur image banao"; setMode('image'); sendMessage(); }; loading.appendChild(again);
     chat.scrollTop=chat.scrollHeight;
     speak("Tumhari image ban gayi! Dekho kaisi lagi?");
   };
   testImg.onerror=()=>{ loading.textContent="Image banane me thoda time laga, dobara try karo."; };
   testImg.src=imgUrl;
   return;
 }

 // 2. NORMAL CHAT / PHOTO SAMAJHNA
 const loading=addMessage("Ankit AI सोच रहा है...", "ai");
 try{
   let reply=""; try{ reply=await callAI(text); }catch(e){}
   if(reply){ loading.textContent=reply; const sb=document.createElement("button"); sb.className="speakBtn"; sb.innerText="🔊 Suno"; sb.onclick=()=>speak(reply); loading.appendChild(sb); speak(reply); }
   else { loading.textContent="Thoda network issue hai, phir se try karo."; }
 }catch(e){ loading.textContent="Network issue, phir try karo."; }
}
</script>
</body>
</html>
